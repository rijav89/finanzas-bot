# Copiar a .env y completar. NUNCA commitear .env (chmod 600 en el servidor).

# Runtime de la API — rol panel_web (NOSUPERUSER, NOBYPASSRLS), se crea en la migración 004
# Hasta que exista el rol panel_web (F6), usar temporalmente el mismo rol postgres.
DATABASE_URL=postgresql+asyncpg://USUARIO:PASSWORD@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?ssl=require

# Migraciones Alembic — rol postgres (DDL). Solo se usa al correr alembic.
ALEMBIC_DATABASE_URL=postgresql+psycopg://USUARIO:PASSWORD@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth (GoTrue)
SUPABASE_URL=https://PROYECTO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# IA (insights)
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_TEXT=qwen-plus

# App
ENTORNO=dev
COOKIE_SECURE=true
